{
  "testCaseId": "TC-0011",
  "name": "テストピラミッド診断のデータ駆動パラメータセット",
  "description": "各工程のテストケース分布比率に応じた健全性判定（healthy, inverted_ice_cream, hollow_hourglass）の検証パラメータ群",
  "patterns": [
    {
      "id": "pattern-pyramid-healthy",
      "name": "健全なピラミッド分布 (UT多、IT中、ST少、UAT極小)",
      "inputs": {
        "unit": 60,
        "integration_internal": 25,
        "integration_external": 10,
        "system": 8,
        "acceptance": 2
      },
      "expected": {
        "status": "healthy",
        "hasWarnings": false
      }
    },
    {
      "id": "pattern-pyramid-inverted",
      "name": "逆ピラミッドアンチパターン (E2E/UAT過多、UT僅少)",
      "inputs": {
        "unit": 3,
        "integration_internal": 2,
        "integration_external": 1,
        "system": 20,
        "acceptance": 45
      },
      "expected": {
        "status": "inverted_ice_cream",
        "hasWarnings": true
      }
    },
    {
      "id": "pattern-pyramid-hollow",
      "name": "中間空洞化アンチパターン (結合層が欠落)",
      "inputs": {
        "unit": 50,
        "integration_internal": 0,
        "integration_external": 0,
        "system": 0,
        "acceptance": 15
      },
      "expected": {
        "status": "hollow_hourglass",
        "hasWarnings": true
      }
    }
  ]
}
