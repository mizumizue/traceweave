{
  "testCaseId": "TC-0010",
  "name": "品質充足度スコア計算のデータ駆動パラメータセット",
  "description": "要件の重要度（criticality）と各工程のテストケース件数の組み合わせによる充足度スコア（0〜100%）の検証パラメータ群",
  "patterns": [
    {
      "id": "pattern-1",
      "name": "重要度High: 単体・内結・外結・受入が揃った理想充足",
      "inputs": {
        "criticality": "high",
        "phaseCounts": {
          "unit": 3,
          "integration_internal": 2,
          "integration_external": 1,
          "system": 1,
          "acceptance": 1
        }
      },
      "expected": {
        "score": 100,
        "isFullySatisfied": true
      }
    },
    {
      "id": "pattern-2",
      "name": "重要度High: 単体テストのみ（結合テスト・受入テスト欠落の不完全状態）",
      "inputs": {
        "criticality": "high",
        "phaseCounts": {
          "unit": 5,
          "integration_internal": 0,
          "integration_external": 0,
          "system": 0,
          "acceptance": 0
        }
      },
      "expected": {
        "score": 30,
        "isFullySatisfied": false
      }
    },
    {
      "id": "pattern-3",
      "name": "重要度Medium: 単体と内部結合テストが存在する適正状態",
      "inputs": {
        "criticality": "medium",
        "phaseCounts": {
          "unit": 2,
          "integration_internal": 2,
          "integration_external": 0,
          "system": 0,
          "acceptance": 0
        }
      },
      "expected": {
        "score": 100,
        "isFullySatisfied": true
      }
    },
    {
      "id": "pattern-4",
      "name": "重要度Low: 単体テスト1件のみで完全充足",
      "inputs": {
        "criticality": "low",
        "phaseCounts": {
          "unit": 1,
          "integration_internal": 0,
          "integration_external": 0,
          "system": 0,
          "acceptance": 0
        }
      },
      "expected": {
        "score": 100,
        "isFullySatisfied": true
      }
    },
    {
      "id": "pattern-5",
      "name": "境界値: テストケースが0件（未テスト状態）",
      "inputs": {
        "criticality": "high",
        "phaseCounts": {
          "unit": 0,
          "integration_internal": 0,
          "integration_external": 0,
          "system": 0,
          "acceptance": 0
        }
      },
      "expected": {
        "score": 0,
        "isFullySatisfied": false
      }
    }
  ]
}
