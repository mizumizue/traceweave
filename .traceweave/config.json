{
  "schemaVersion": 1,
  "displayName": "TraceWeave",
  "docsDir": "docs",
  "evidenceDir": "reports",
  "testResults": {
    "aggregate": "reports/test-results.json",
    "format": "traceweave-v1"
  },
  "coverage": {
    "lcov": "reports/lcov.info",
    "summary": "reports/coverage-summary.json"
  },
  "merge": {
    "onConflict": "fail-wins"
  },
  "suites": [
    {
      "id": "node",
      "label": "TypeScript test suite (Node test runner, formal)",
      "cwd": ".",
      "run": "",
      "capture": "node-test-tap",
      "evidenceTier": "formal",
      "fragment": "reports/suites/node.json"
    },
    {
      "id": "support",
      "label": "Supplementary harness (web-contract, static analysis)",
      "cwd": ".",
      "run": "",
      "capture": "node-test-tap",
      "evidenceTier": "supplementary",
      "testsDir": "tests/support",
      "fragment": "reports/suites/support.json"
    },
    {
      "id": "e2e",
      "label": "Browser E2E (Playwright)",
      "cwd": ".",
      "run": "node src/node_modules/tsx/dist/cli.mjs scripts/run-e2e-suite.ts",
      "capture": "fragment",
      "evidenceTier": "formal",
      "fragment": "reports/suites/e2e.json"
    },
    {
      "id": "newman-api",
      "label": "Serve HTTP API (Newman / Postman)",
      "cwd": ".",
      "run": "node src/node_modules/tsx/dist/cli.mjs scripts/run-newman-api-suite.ts",
      "capture": "fragment",
      "evidenceTier": "formal",
      "fragment": "reports/suites/newman.json"
    }
  ]
}
