#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

export NODE_PATH="$ROOT/src/node_modules${NODE_PATH:+:$NODE_PATH}"

if [[ "${1:-}" == "serve" ]] && [[ -f "$ROOT/src/dist/cli/index.js" ]]; then
  echo ""
  echo "⚙ Building CLI before serve..."
  npm run build:cli --prefix "$ROOT/src"
fi

if [[ -f "$ROOT/src/dist/cli/index.js" ]]; then
  exec node "$ROOT/src/dist/cli/index.js" "$@"
else
  exec "$ROOT/src/node_modules/.bin/tsx" "$ROOT/src/cli/index.ts" "$@"
fi
